# Copy to .env.development (or .env.local) and fill in.

# Postgres connection used by the API routes and `npm run db:*`. The app builds the connection
# URL from these, so the password can contain any characters.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=db_ioverlay
# Set to true for hosted databases that require SSL (Neon, Supabase, RDS and so on).
DB_SSL=false

# Outgoing email over SMTP. Without SMTP_HOST, development prints emails to the server log and
# production refuses to send. Use your mail provider's SMTP settings for support@i-overlay.com
# (Hostinger: smtp.hostinger.com, port 465, the mailbox address and password. Others work too:
# Google Workspace, Zoho, Amazon SES, Resend, Brevo and similar).
SMTP_HOST=
# 587 uses STARTTLS; 465 uses TLS from the start. SMTP_SECURE defaults to true only for 465.
SMTP_PORT=465
SMTP_USER=support@i-overlay.com
SMTP_PASSWORD=

# Optional. Defaults: "iOverlay Support <support@i-overlay.com>" and support@i-overlay.com.
# MAIL_FROM=
# SUPPORT_INBOX=

# BCC copies of outgoing emails, comma-separated. MAIL_BCC is copied on every email.
# MAIL_BCC_<FEATURE> is copied only on that feature's emails, e.g. MAIL_BCC_CONTACT for the
# contact form, MAIL_BCC_PAYMENT for payment emails. Addresses already in To or Cc are skipped.
MAIL_BCC=
MAIL_BCC_CONTACT=

# Public address of the site, used for links in emails. Defaults to https://i-overlay.com.
# SITE_URL=
